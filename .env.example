# Eitaa Web URL that the browser will open (use the one you actually use)
EITAA_WEB_URL=https://web.eitaa.com

# Where isolated browser profiles are stored (one folder per account)
PROFILES_DIR=./profiles

# Where capture output is written (per-run folders)
ARTIFACTS_DIR=./artifacts

# Run the browser with a visible window (1) or headless (0).
# For manual login you need a visible window: on a server use xvfb/noVNC.
HEADED=1

# Seconds of idle baseline traffic recorded before an action
BASELINE_SECONDS=12

# Extra seconds to keep recording after an action (to catch async replies)
ACTION_TRAIL_SECONDS=8

# Optional AES key (32-byte, base64/hex/plain) to encrypt raw bytes on disk.
# Leave empty to skip storing raw bodies entirely.
RAW_ENCRYPTION_KEY=

# --- Send pacing: TELEGRAM PANEL ---
# Seconds to wait between sends (with concurrency > 1: between BATCHES). The
# panel's Settings screen changes this live; this is only the starting value.
TEXT_SEND_DELAY=3

# How many recipients may be in flight at once on the fast in-page path.
# 1 = the proven sequential behaviour. Try 3 and watch for limit cards.
# The UI fallback always stays sequential (it drives a single browser page).
SEND_CONCURRENCY=1

# A server-declared FLOOD_WAIT up to this many seconds is obeyed and the run
# continues; anything longer stops the run and reports it.
MAX_FLOOD_WAIT=90

# Max consecutive send failures before the campaign auto-pauses (safety brake).
MAX_CONSECUTIVE_FAILURES=5

# --- Send pacing: CLI CAMPAIGN ONLY (python cli.py campaign) ---
# The Telegram panel does NOT read these four. Changing them affects only the
# command-line broadcaster in jobs/campaign.py.
SEND_MIN_DELAY=8
SEND_MAX_DELAY=18
SEND_BATCH_SIZE=20
SEND_BATCH_COOLDOWN=90


# ============================================================
#  Telegram control bot (panel)
# ============================================================
# Telethon needs an API_ID/API_HASH from https://my.telegram.org (API development
# tools) and a bot token from @BotFather. OWNER_ID is your own Telegram numeric
# user id (get it from @userinfobot); it is the ONLY id allowed to use the panel.
API_ID=
API_HASH=
BOT_TOKEN=
OWNER_ID=

# Where log cards are posted. Leave empty to send them to OWNER_ID (a private
# chat with the bot). To use a group, put the group id here.
REPORT_TO=

# Panel version label shown on the home card.
BOT_VERSION=1.0

# Runtime send/contact speeds (also changeable live from the Settings panel).
# TEXT_SEND_DELAY: seconds between each text/file send.
# CONTACT_CREATE_DELAY: seconds between each contact creation.
# SEND_LOG_EVERY: post a progress card every N sends/creations.
TEXT_SEND_DELAY=8
CONTACT_CREATE_DELAY=3
SEND_LOG_EVERY=50

# Where the bot keeps its session + state (bot_state.json, downloaded content).
DATA_DIR=./data


# --- Browser cost control (matters a lot on a weak VPS) ---
# HEADED shows a real Chromium window (only needed for a manual noVNC login).
# The BOT's own jobs do not need pixels: they drive Eitaa through its own API
# inside the page. Headless starts faster and uses far less RAM.
# Set MKWL_HEADED_JOBS=1 only if you want to watch a job over noVNC.
MKWL_HEADED_JOBS=0

# Block images, video and web fonts. The automation never looks at them, and on
# a slow link they dominate page-load time. Set to 0 for a fully normal page.
MKWL_LIGHT_ASSETS=1

# Hard limits for the slow browser-UI send path (seconds). A stuck UI send once
# froze a whole run for 13 minutes with zero deliveries.
MKWL_UI_FILE_TIMEOUT=150
MKWL_UI_TEXT_TIMEOUT=60


# How long to wait for Eitaa Web to switch to its logged-in UI after a
# successful sign-in. Two quick checks used to report a good login as
# incomplete on a slow host.
MKWL_LOGIN_SETTLE_TIMEOUT=120

# What to do when the server reports a restriction with no wait time
# (PEER_FLOOD and friends). 1 = pause the run (safe default), 0 = only post a
# card and keep going; then only Stop or the failure brake ends the run.
MKWL_STOP_ON_LIMIT=1

# How many deliveries may sit in memory before the "already sent to" ledger is
# written to disk. Whatever is still in memory when the process dies is lost,
# and those people get the message a second time on the next run. A send waits
# seconds between recipients, so a small batch costs nothing. Was 25.
MKWL_LEDGER_FLUSH=5        # set to 25 to restore the old batching exactly


# --- Browser standby pool ---
# Chromium takes 158-203s to start on a weak host. The pool opens a session only
# when a job asks for one, keeps it warm for a while, then closes it. Sessions are
# also recycled so a long-lived browser cannot grow unchecked.
MKWL_SESSION_POOL=1        # 0 = a fresh browser per job (old behaviour)
MKWL_POOL_IDLE_TTL=240     # close a standby session after this many idle seconds
MKWL_POOL_MAX_OPEN=1       # how many may be warm at once (1 GB host -> 1)
MKWL_POOL_MAX_USES=25      # recycle a session after this many jobs
MKWL_POOL_MAX_AGE=1800     # ...or after this many seconds, whichever comes first

# --- Warm Path engine (isolated, opt-in) ---
# The pool keeps the BROWSER warm, but driver.open() still navigated to
# web.eitaa.com for every job, so the web app re-ran its whole startup sync
# (getConfig/getState/getDifference/getDialogs) before the bot's own single
# contacts.getContacts. Warm Path reuses the page when it is already booted:
# one app boot per sitting instead of five. It also routes the Settings
# "refresh stats" button through the pool and skips the 98-second getDialogs
# PV count there. OFF by default; turning it off restores the old behaviour
# exactly. Toggle live in Settings -> "Warm Path". See eitaa/warmpath.py.
MKWL_WARMPATH=0            # 1 = reuse the booted page instead of reloading it

# --- Contact Boost (isolated, opt-in, see contacts_boost/) ---
# After an account is added, probe a block of numbers under BOOST_PREFIX through
# contacts.importContacts and keep whoever actually exists on Eitaa. The result
# card shows the REAL contact count before and after, measured with
# contacts.getContacts -- not the server's own `imported` tally, which counts a
# number as imported even when it was already a contact.
#
# ONE RUN = BOOST_PROBE numbers, not BOOST_PROBE contacts. Most random numbers
# are not on Eitaa, so whatever the block yields is the result. That is
# deliberate: it keeps the number of calls fixed, and a brand-new account is
# exactly what PEER_FLOOD punishes fastest.
#
# A number is never probed twice for the same account: the position in the range
# is saved per account in DATA_DIR/boost_<account>.json, so pressing Boost again
# continues with the NEXT block. The panel setting overrides these values.
MKWL_BOOST=0               # 1 = boost a new account right after login
MKWL_BOOST_PREFIX=         # e.g. 0916 or 091646 (Settings -> Boost Prefix)
MKWL_BOOST_PROBE=400       # numbers per run (about: see MKWL_BOOST_JITTER)
MKWL_BOOST_BATCH=50        # numbers per importContacts call (proven value)
# Numbers are picked at RANDOM from across the whole prefix. Sequential is both
# an obvious machine fingerprint (a real person's contacts are not ...0000,
# ...0001, ...0002 in a row) and liable to sit inside a dead sub-block and return
# almost nobody. Set to "sequential" for the old in-order walk.
MKWL_BOOST_ORDER=random
# The memory of which numbers have been handed out is SHARED between accounts,
# so no two accounts ever get the same number -- their contact lists cannot end
# up identical, and a multi-account send does not deliver the same message to the
# same person once per account. 0 gives each account its own memory instead.
MKWL_BOOST_SHARED_RANGE=1
# Seconds between importContacts batches. The manual Build Contacts job uses
# CONTACT_CREATE_DELAY (0.2s); the boost runs unattended right after a login, on
# the account Eitaa watches most closely, so it paces itself properly.
MKWL_BOOST_DELAY=2
# How much the per-run count wobbles, in percent, so runs are not all exactly
# the same size. 0 = always exactly MKWL_BOOST_PROBE.
MKWL_BOOST_JITTER=10

# --- Photo export (isolated, see photo_export/) ---
# Walks this account's PRIVATE chats, searches each for photos, downloads them
# and renders a PDF with ONE PHOTO PER PAGE, then sends the file(s) here.
# Read-only on Eitaa: nothing is sent to anybody there. Measured on the live
# account: ~55 ms per chat scanned at concurrency 8, ~30 ms per photo at
# concurrency 16 with no FLOOD_WAIT, ~90-120 ms per PDF page.
MKWL_PHOTO_DIRECTION=both  # both | sent | received (the panel cycles this too)
MKWL_PHOTO_MAX=500         # cap per export; newest first when it bites
MKWL_PHOTO_PER_FILE=150    # pages per PDF; a big export is split across files
MKWL_PHOTO_WIDTH=320       # preferred px width; the nearest Eitaa size is used
                           # (296 or 1080 -- use 1080 for a sharper full page)
# Pacing. Running flat out is what earned a FLOOD_WAIT and cost 485 photos, so
# the export is deliberately slow: low concurrency plus a pause between batches.
# With these defaults a 500-photo run lands around 6-7 minutes. Same trade as
# TEXT_SEND_DELAY for sends -- raise the delays to be gentler still.
MKWL_PHOTO_CONC=3          # photos downloaded at once (halves on every flood)
MKWL_PHOTO_DELAY=8         # seconds between download batches of 24
MKWL_PHOTO_SCAN_CONC=4     # chats searched at once
MKWL_PHOTO_SCAN_DELAY=2    # seconds between scan slices of 40 chats

# --- Multi-account send width ---
# 1 is the original one-account-at-a-time run. 2 lets a second account send while
# the first is pacing -- and pacing is where the time goes (a measured run spent
# 563s of 771s deliberately waiting), so the browsers mostly sit idle rather than
# competing. The bridge engine needs one Chromium per account, because the Eitaa
# session lives in IndexedDB and cannot be shared between contexts, which is what
# caps this. Toggle live in Multi Send -> "Mode".
MKWL_MULTI_PARALLEL=1        # accounts sending at once (1 = sequential)
MKWL_MULTI_PARALLEL_MAX=2    # ceiling the panel toggle may reach
# Eitaa's limits are not per-account and every account leaves from this one IP,
# so two accounts at the configured delay would double the pressure. With this on
# each account's delay is scaled by the width, keeping the combined rate the same
# as a sequential run. Set to 0 to trade that safety for wall-clock speed.
MKWL_MULTI_SHARE_BUDGET=1
MKWL_MULTI_STAGGER=10        # seconds before each slot after the first starts

# How old the browser-free engine's session capture may be before a run insists on
# opening a browser (only a real page can refresh that capture).
MKWL_CONTEXT_MAX_AGE_H=12
