# Eitaa Web URL that the browser will open (use the one you actually use)
EITAA_WEB_URL=https://web.eitaa.com

# Where isolated browser profiles are stored (one folder per account)
PROFILES_DIR=./profiles

# Where capture output is written (per-run folders)
ARTIFACTS_DIR=./artifacts

# Run the browser with a visible window (1) or headless (0).
# For manual login you need a visible window: on a server use xvfb/noVNC.
HEADED=1

# Seconds of idle baseline traffic recorded before an action
BASELINE_SECONDS=12

# Extra seconds to keep recording after an action (to catch async replies)
ACTION_TRAIL_SECONDS=8

# Optional AES key (32-byte, base64/hex/plain) to encrypt raw bytes on disk.
# Leave empty to skip storing raw bodies entirely.
RAW_ENCRYPTION_KEY=

# --- Broadcaster (tabchi) rate limiting ---
# Random delay between two sends, in seconds (min..max). Keep these humane to
# avoid tripping Eitaa's own spam/rate limits. Do not set them tiny.
SEND_MIN_DELAY=8
SEND_MAX_DELAY=18

# Pause this many seconds after every N sends (a longer cooldown).
SEND_BATCH_SIZE=20
SEND_BATCH_COOLDOWN=90

# Max consecutive send failures before the campaign auto-pauses (safety brake).
MAX_CONSECUTIVE_FAILURES=5


# ============================================================
#  Telegram control bot (panel)
# ============================================================
# Telethon needs an API_ID/API_HASH from https://my.telegram.org (API development
# tools) and a bot token from @BotFather. OWNER_ID is your own Telegram numeric
# user id (get it from @userinfobot); it is the ONLY id allowed to use the panel.
API_ID=
API_HASH=
BOT_TOKEN=
OWNER_ID=

# Where log cards are posted. Leave empty to send them to OWNER_ID (a private
# chat with the bot). To use a group, put the group id here.
REPORT_TO=

# Panel version label shown on the home card.
BOT_VERSION=1.0

# Runtime send/contact speeds (also changeable live from the Settings panel).
# TEXT_SEND_DELAY: seconds between each text/file send.
# CONTACT_CREATE_DELAY: seconds between each contact creation.
# SEND_LOG_EVERY: post a progress card every N sends/creations.
TEXT_SEND_DELAY=8
CONTACT_CREATE_DELAY=3
SEND_LOG_EVERY=50

# Where the bot keeps its session + state (bot_state.json, downloaded content).
DATA_DIR=./data
